---
layout: base.njk
---
{% if math %}
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js" onload="renderMathInElement(document.querySelector('.post-content'), { delimiters: [ {left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false} ] });"></script>
{% endif %}
<section class="section" style="padding-top: 8rem;">
    <div class="container">
        <div style="max-width: 760px; margin: 0 auto;">
            <a href="/blog/" style="color: var(--primary-color); text-decoration: none; font-weight: 600; font-size: 0.875rem;">&larr; Back to Blog</a>

            <h1 style="margin: 1.5rem 0 0.75rem; font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.2;">{{ title }}</h1>

            <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                {{ date | readableDate }}{% for tag in tags %}{% if tag != "posts" %} &bull; {{ tag }}{% endif %}{% endfor %}
            </p>

            {% if image %}
            <img src="{{ image }}" alt="" width="1024" height="536" fetchpriority="high" style="width: 100%; height: auto; border-radius: var(--border-radius-lg); margin-bottom: 2rem; box-shadow: var(--shadow-md);" />
            {% endif %}

            <div class="post-content">
                {{ content | safe }}
            </div>

            <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); text-align: center;">
                <p style="color: var(--text-secondary); margin-bottom: 1rem;">Enjoyed this? I write more often on the newsletter.</p>
                <a href="https://farmstofirewalls.substack.com/" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Subscribe to Farms to Firewalls</a>
            </div>
        </div>
    </div>
</section>
