---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
<channel>
  <title>{{ site.name }} - Blog</title>
  <link>{{ site.url }}/blog/</link>
  <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />
  <description>Original, longer-form posts by Andrew Krug on cloud security, AI security, and building systems that hold up. Articles published elsewhere are indexed at {{ site.url }}/writing/ and are not in this feed.</description>
  <language>en-us</language>
{%- set newest = collections.posts | last %}
{%- if newest %}
  <lastBuildDate>{{ newest.date.toUTCString() }}</lastBuildDate>
{%- endif %}
{%- for post in collections.posts | reverse %}
  <item>
    <title>{{ post.data.title }}</title>
    <link>{{ site.url }}{{ post.url }}</link>
    <guid>{{ site.url }}{{ post.url }}</guid>
    <pubDate>{{ post.date.toUTCString() }}</pubDate>
    <description>{{ post.data.description }}</description>
    <dc:creator>{{ site.author.name }}</dc:creator>
  </item>
{%- endfor %}
</channel>
</rss>
